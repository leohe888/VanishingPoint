<RCC>
    <qresource prefix="/">
        <file>qml/main.qml</file>
        <file>qml/ToolBar.qml</file>
        <file>qml/ToolButton.qml</file>
        <file>qml/ParameterBar.qml</file>
        <file>qml/HintBar.qml</file>
        <file>qml/PerspectiveCanvas.qml</file>
        <file alias="assets/icons/brush.png">../assets/icons/brush.png</file>
        <file alias="assets/icons/marquee.png">../assets/icons/marquee.png</file>
        <file alias="assets/icons/perspective.png">../assets/icons/perspective.png</file>
        <file alias="assets/icons/pointer.png">../assets/icons/pointer.png</file>
        <file alias="assets/icons/stamp.png">../assets/icons/stamp.png</file>
        <file alias="assets/icons/transform.png">../assets/icons/transform.png</file>
    </qresource>
</RCC>
